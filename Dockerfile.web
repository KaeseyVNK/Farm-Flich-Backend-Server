# Next.js standalone image (phase 10 F10.3) + staging deploy variant.
# Multi-stage: build → ship standalone server.js + static + public.
# Staging thêm: (1) ARG NEXT_PUBLIC_* — bake client bundle lúc build (workflow
# deploy-hgpp-staging truyền --build-arg; NEXT_PUBLIC_ không override runtime);
# (2) stage prisma-cli riêng → /migrate cho initContainer `migrate` (prisma CLI
# cần deps riêng như `effect` — copy lẻ node_modules/prisma từ builder không đủ,
# CrashLoop đã verify). /migrate tách hẳn /app: web runtime không đụng.
# Local docker-compose.prod.yml build không truyền build-arg — NEXT_PUBLIC_ sẽ
# rỗng trong bản build local (biết trước; staging luôn build qua workflow).
FROM oven/bun:1.3 AS deps
WORKDIR /app
COPY package.json bun.lock* ./
COPY prisma ./prisma
RUN bun install --frozen-lockfile

FROM oven/bun:1.3 AS builder
WORKDIR /app
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_RAID_WS_URL
ARG NEXT_PUBLIC_RAID_HTTP_URL
ARG SKIP_ENV_VALIDATION
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN bunx prisma generate && bun run build

# Prisma CLI tự-contained cho initContainer migrate. LƯU Ý: làm TRONG runner
# stage (RUN) — kaniko bỏ COPY --from stage trung gian không phải builder
# (/migrate biến mất khỏi image đã push, verified debug pod 2026-08-18).
FROM oven/bun:1.3 AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/standalone/.next ./.next
COPY --from=builder /app/public ./public
# migrate initContainer: workingDir /migrate, chạy
# `bun ./node_modules/prisma/build/index.js migrate deploy` (schema + migrations
# trong /migrate/prisma; image oven/bun không có node — .bin shim shebang fail;
# bun cần prefix ./ nếu không sẽ resolve như package specifier).
RUN mkdir /migrate && cd /migrate && bun add prisma@6.19.2
COPY --from=builder /app/prisma /migrate/prisma
EXPOSE 3000
CMD ["bun", "server.js"]
